    {
      "id": "feae698f-1d36-54e5-81e6-cdbc96ed539e",
      "name": "Solicitud solo texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        300
      ],
      "parameters": {
        "jsCode": "'use strict';\nconst domains=['aurora_demo','outer_agent'];\nfunction exact(o, keys, label){if(!o||typeof o!=='object'||Array.isArray(o))throw Error(label+' object required');for(const k of Object.keys(o))if(!keys.includes(k))throw Error(label+' unexpected '+k);for(const k of keys)if(!(k in o))throw Error(label+' missing '+k);}\nfunction text(v,label,max=4000){if(typeof v!=='string'||!v.trim()||v.length>max)throw Error(label+' invalid');}\nfunction evidence(v,domain){if(!Array.isArray(v))throw Error('evidence invalid');for(const e of v){exact(e,['source_id','source_kind','text','section','page_start','page_end','score','source_version'],'evidence');text(e.source_id,'source_id');text(e.text,'evidence text',12000);if(!['aurora_sheet','outer_agent_pdf'].includes(e.source_kind))throw Error('source_kind invalid');if(e.source_kind!==(domain==='aurora_demo'?'aurora_sheet':'outer_agent_pdf'))throw Error('evidence domain mismatch');}}\nfunction validateRequest(r){exact(r,['schema_version','request_id','session_id','domain','channel','query','user','context','evidence','candidate','correction_attempt','mode'],'request');if(r.schema_version!=='1')throw Error('version invalid');if(!domains.includes(r.domain))throw Error('domain invalid');text(r.request_id,'request_id',200);text(r.session_id,'session_id',250);if(!r.session_id.startsWith(r.domain+':'+r.channel+':'))throw Error('session domain mismatch');if(!['chat','gmail','telegram'].includes(r.channel))throw Error('channel invalid');text(r.query,'query');exact(r.user,['display_name','email'],'user');exact(r.context,['summary','case_status','key_facts'],'context');if(!Array.isArray(r.context.key_facts)||r.context.key_facts.length>5)throw Error('key facts invalid');if(r.candidate!==null&&typeof r.candidate!=='string')throw Error('candidate invalid');if(!Number.isInteger(r.correction_attempt)||r.correction_attempt<0||r.correction_attempt>2)throw Error('attempt invalid');if(!['dry_run','live'].includes(r.mode))throw Error('mode invalid');evidence(r.evidence,r.domain);return r;}\nfunction validateResult(r,q){validateRequest(q);exact(r,['schema_version','request_id','status','domain','result','error'],'result');if(r.domain!==q.domain)throw Error('domain mismatch');if(r.request_id!==q.request_id)throw Error('request_id mismatch');if(r.schema_version!=='1'||!['success','error','needs_human'].includes(r.status))throw Error('status/version invalid');exact(r.result,['answer','evidence','proposed_action'],'result body');evidence(r.result.evidence,r.domain);if(typeof r.result.answer!=='string')throw Error('answer invalid');if(!['none','draft_email','review'].includes(r.result.proposed_action))throw Error('action invalid');if(r.status==='success'){text(r.result.answer,'answer',12000);if(r.error!==null)throw Error('success has error');}else if(r.status==='error'){exact(r.error,['code','message','retryable'],'error');if(r.result.answer!=='')throw Error('failed answer must be empty');}return r;}\nfunction failure(q,code,message){return {schema_version:'1',request_id:q.request_id,status:'error',domain:q.domain,result:{answer:'',evidence:[],proposed_action:'review'},error:{code,message,retryable:false}};}\n\nconst d=$input.first().json,q=$('Validar voz').first().json,t=$('Transcribir voz').first().json,domain=d.output?.domain;if(d.error||!['aurora_demo','outer_agent'].includes(domain))return [{json:{ok:false}}];const request=validateRequest({schema_version:'1',request_id:q.request_id,session_id:domain+':telegram:'+q.chat_id,domain,channel:'telegram',query:t.text,user:{display_name:'Prueba de voz',email:null},context:{summary:null,case_status:'nuevo',key_facts:[]},evidence:[],candidate:null,correction_attempt:0,mode:'dry_run'});return [{json:{ok:true,request}}];"
      }
    },
