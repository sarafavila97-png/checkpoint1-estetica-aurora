    {
      "id": "1b7abaec-fb1a-524b-8de7-22eacfe2b421",
      "name": "Dominio JSON",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2640,
        650
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"domain\": {\"type\": \"string\", \"enum\": [\"aurora_demo\", \"outer_agent\", \"clarify\"]}}, \"required\": [\"domain\"], \"additionalProperties\": false}"
